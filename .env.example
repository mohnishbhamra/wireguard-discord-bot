# ============================================================================
# 1. DISCORD BOT CONFIGURATION
# ============================================================================
# Your personal Discord User ID (18-19 digits). Only this user can execute bot commands!
# How to get: Discord Settings -> Advanced -> Turn ON Developer Mode -> Right-click your profile -> Copy User ID
DISCORD_MASTER_ID=your_discord_user_id_here

# Bot Token from Discord Developer Portal -> Bot Tab -> Reset Token
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Application ID from Discord Developer Portal -> General Information Tab
DISCORD_CLIENT_ID=your_discord_application_id_here

# Your Private Discord Server (Guild) ID where slash commands will be registered instantly
# How to get: Right-click your server icon in Discord -> Copy Server ID
DISCORD_SERVER_ID=your_discord_server_id_here


# ============================================================================
# 2. ENVIRONMENT / TESTING MODE
# ============================================================================
# Set to 'true' when developing/testing locally on Windows or macOS (generates dummy configs/QRs).
# Set to 'false' when deployed on your Linux WireGuard server (OCI, AWS, DigitalOcean, etc.).
MOCK_MODE=true

# Dummy server endpoint used in generated configs when MOCK_MODE=true
MOCK_ENDPOINT=127.0.0.1:51820


# ============================================================================
# 3. WIREGUARD & SERVER PATHS (Only used when MOCK_MODE=false)
# ============================================================================
# Full absolute path to the wg-bot-helper.sh script on your Linux server.
# Tip: Run `pwd` inside your cloned repository on the server to get the exact folder path.
# Examples:
#   - Inside cloned repo (Ubuntu/OCI): /home/ubuntu/wireguard-discord-bot/wg-bot-helper.sh
#   - System-wide bin path:            /usr/local/bin/wg-bot-helper.sh
WG_HELPER_PATH=/home/ubuntu/wireguard-discord-bot/wg-bot-helper.sh

# Directory where generated client .conf files will be saved and read from.
# Examples:
#   - Oracle Cloud (OCI) / Ubuntu: /home/ubuntu
#   - AWS EC2 (Amazon Linux/Debian): /home/ec2-user or /home/admin
#   - DigitalOcean / Root droplet: /root
WG_CONFIG_DIR=/home/ubuntu

# Your active WireGuard network interface name (default is wg0)
WG_INTERFACE=wg0