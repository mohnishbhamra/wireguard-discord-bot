# Discord Bot Configuration
DISCORD_MASTER_ID=your_discord_user_id_here
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_application_id_here
DISCORD_SERVER_ID=your_discord_server_id_here

# Local Development / Testing Mode (true for Windows/Mac, false for Linux Production)
MOCK_MODE=true
MOCK_ENDPOINT=127.0.0.1:51820

# WireGuard & Server Paths (Used when MOCK_MODE=false)
WG_HELPER_PATH=/usr/local/bin/wg-bot-helper.sh
WG_CONFIG_DIR=/home/ubuntu
WG_INTERFACE=wg0